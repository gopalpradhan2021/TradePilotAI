[Unit]
Description=TradePilotAI status dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/groww-agent
ExecStart=/home/trader/groww-agent/venv/bin/uvicorn dashboard.app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/trader/groww-agent/logs/dashboard.log
StandardError=append:/home/trader/groww-agent/logs/dashboard.log

[Install]
WantedBy=multi-user.target
