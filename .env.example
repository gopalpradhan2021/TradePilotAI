GROWW_API_KEY=your_totp_api_key_here
GROWW_TOTP_SECRET=your_totp_secret_here

MAX_ORDER_VALUE_INR=5000
MAX_DAILY_LOSS_INR=2000
MAX_TRADES_PER_DAY=10
MAX_POSITION_QTY=50
PRICE_SANITY_BAND_PCT=3.0

MODE=PAPER

# Candle interval MARsiStrategy computes MA/RSI trend signals from (e.g. "1minute",
# "5minute", "15minute", "1hour", "1day") — separate from execution/stop-loss, which always
# use live tick data regardless of this setting. See strategies/ma_rsi_strategy.py's
# CANDLE_INTERVAL comment for why.
CANDLE_INTERVAL=5minute

# Third guard (alongside --live and MODE=LIVE) before main.py will construct a
# LiveBroker at all. Only set to true once you've run scripts/backtest.py
# against historical data and are satisfied with paper-trading results.
BACKTEST_VALIDATED=false

# F&O (futures & options) — all off by default. ALLOW_FNO is the master gate (existing);
# ALLOW_FNO_INDEX is a second, narrower gate specifically for the index-options strategy
# (strategies/iv_oi_strategy.py) so F&O infrastructure can be enabled/tested without also
# green-lighting its live trades. FNO_PRODUCT defaults to NRML (positions can be held
# across sessions) — set to MIS for same-day-only F&O instead.
ALLOW_FNO=false
ALLOW_FNO_INDEX=false
FNO_PRODUCT=NRML
# No historical option-chain data exists to run a real backtest against (see
# core/execution.py's F&O research notes) — this is an honest substitute for
# BACKTEST_VALIDATED: true only after a stretch of PAPER-mode decide_fno() output has
# actually been reviewed, not a stand-in for a real backtest.
FNO_PAPER_VALIDATED=false

DATABASE_PATH=data/trading.db

NTFY_TOPIC=

DASHBOARD_PASSWORD=
# Signs the dashboard's login session cookie. Set to a long random string (e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`) so operators stay logged in
# across dashboard restarts/deploys — if left unset, a random key is generated at each process
# start and everyone gets logged out on every deploy.
SESSION_SECRET_KEY=
